<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dofbot_moveit_dry</name>
  <version>0.1.0</version>
  <description>DOFBOT Pro arm_group collision-aware planning만 검사한다. trajectory를 실행하지 않는다.</description>
  <maintainer email="woonkil@users.noreply.github.com">woonkil</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>urdf</depend>
  <depend>robot_controller</depend>
  <depend>vision_path_generator</depend>
  <depend>eigen</depend>

  <exec_depend>dofbot_pro_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
