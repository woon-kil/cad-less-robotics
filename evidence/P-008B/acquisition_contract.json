{
  "camera_model": "Orbbec Gemini 335L",
  "serial": "CP263630009D",
  "firmware": "1.4.60",
  "driver_version": "OrbbecSDK_ROS2 v2.10.6",
  "device_preset": "Default",
  "color_resolution": [1280, 720],
  "color_fps": 30,
  "color_format": "MJPG",
  "color_encoding": "rgb8",
  "depth_native_resolution": [848, 480],
  "depth_fps": 30,
  "depth_format": "Y16",
  "depth_encoding": "16UC1",
  "published_depth_resolution_after_d2c": [1280, 720],
  "alignment_enabled": true,
  "alignment_mode": "SW_D2C",
  "align_mode_launch": "SW",
  "align_target_stream": "COLOR",
  "color_frame": "camera_color_optical_frame",
  "depth_frame": "camera_color_optical_frame",
  "cloud_frame": "camera_color_optical_frame",
  "publish_extrinsic": true,
  "extrinsic_source": "driver static TF between optical frames, plus /camera/depth_to_color from getExtrinsicTo",
  "pointcloud_type": "depth_registered_xyzrgb",
  "pointcloud_topic": "/camera/depth_registered/points",
  "expected_point_fields": ["x", "y", "z", "rgb"],
  "timestamp_policy": "한 세트의 ROS stamp 차이는 0.05초 이하여야 한다. Enable frame sync 로그만으로 hardware sync를 주장하지 않는다.",
  "capture_count": 5,
  "depth_cloud_positive_ratio_min": 0.99,
  "depth_cloud_p95_max_m": 0.005,
  "color_in_bounds_ratio_min": 0.999,
  "color_median_abs_channel_max": 15,
  "launch": "ros2 launch orbbec_camera gemini_330_series.launch.py depth_registration:=true align_mode:=SW align_target_stream:=COLOR enable_colored_point_cloud:=true enable_publish_extrinsic:=true enable_point_cloud:=true enable_frame_sync:=true"
}
